{
  "name": "africa-book",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page and mdBook edition for Exploration and Exploitation of Petroleum Resources in West Africa.",
  "scripts": {
    "build": "npm run build:site",
    "build:index": "node scripts/generate-index-page.mjs",
    "build:legal": "node scripts/generate-legal-pages.mjs",
    "build:book-js": "node scripts/strip_mdbook_onunload.mjs",
    "build:static-reader-sidebar": "node scripts/build_static_reader_sidebar.mjs",
    "build:reader-meta": "node scripts/build_reader_page_meta.mjs",
    "build:chapters": "node scripts/generate-chapters-page.mjs chapters",
    "build:docx-figure-manifest": "npm run build:docx-figure-manifest:en",
    "build:docx-figure-manifest:en": "python3 scripts/build_docx_figure_manifest.py --edition en",
    "build:docx-figure-manifest:fr": "python3 scripts/build_docx_figure_manifest.py --edition fr",
    "render:docx-chart-figures": "python3 scripts/render_docx_chart_figures.py",
    "render:docx-shape-figures": "python3 scripts/render_docx_shape_figures.py",
    "render:docx-vector-figures": "python3 scripts/render_docx_vector_figures.py",
    "render:pdf-figures": "python3 scripts/render_pdf_figures.py",
    "check:docx-parity": "npm run check:docx-parity:en",
    "check:docx-parity:en": "python3 scripts/check_docx_parity.py --edition en",
    "check:docx-parity:fr": "python3 scripts/check_docx_parity.py --edition fr",
    "check:docx-parity:all": "npm run check:docx-parity:en && npm run check:docx-parity:fr",
    "check:docx-figures": "npm run check:docx-figures:en",
    "check:docx-figures:en": "python3 scripts/check_docx_figures.py --edition en",
    "check:docx-figures:fr": "python3 scripts/check_docx_figures.py --edition fr",
    "check:docx-figures:all": "npm run check:docx-figures:en && npm run check:docx-figures:fr",
    "build:site": "node scripts/build_site.mjs",
    "test:site": "sh scripts/test-site-render.sh",
    "test:preview-build": "sh scripts/test-preview-build.sh",
    "test:preview-cache": "sh scripts/test-preview-cache.sh",
    "test:book-unload": "sh scripts/test-book-unload-policy.sh",
    "test:reader-meta-compat": "sh scripts/test-reader-meta-compat.sh",
    "preview": "./scripts/preview.sh",
    "serve:book": "mdbook serve editions/en"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.4.1"
  }
}
