{
  "meta": {
    "name": "Africa Book Reader Reference Tokens",
    "version": "2026-06-09",
    "source": "approved-reference-pair",
    "description": "Design tokens distilled from the approved wide-screen and narrow-screen academic reader references."
  },
  "references": {
    "wide": "docs/design-baselines/2026-06-08-reader/wide-reference.png",
    "narrow": "docs/design-baselines/2026-06-08-reader/narrow-reference.png",
    "note": "The current approved narrow-screen reference also uses the full horizontal landing-page logo lockup. The compact logo mark is fallback-only and is not part of the approved pair."
  },
  "primitives": {
    "color": {
      "ink": "#0B1F33",
      "inkMuted": "#526171",
      "inkSoft": "#7C8A9A",
      "paper": "#FFFFFF",
      "pageBg": "#F7F8F9",
      "surfaceSubtle": "#EEF2F4",
      "surfaceWarm": "#FBF8F1",
      "brandBlue": "#3163C2",
      "brandBlueDeep": "#264D97",
      "brandGold": "#D9B24A",
      "accentCopper": "#D88A1D",
      "lineSoft": "rgba(11, 31, 51, 0.08)",
      "line": "rgba(11, 31, 51, 0.10)",
      "lineStrong": "rgba(11, 31, 51, 0.18)",
      "lineBrand": "rgba(49, 99, 194, 0.16)",
      "hoverBrand": "rgba(49, 99, 194, 0.08)",
      "activeBrand": "#3163C2",
      "activeBrandText": "#FFFFFF"
    },
    "typography": {
      "fontFamily": {
        "sans": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
        "serif": "\"Literata\", Georgia, serif"
      },
      "fontSize": {
        "labelXs": "11px",
        "labelSm": "12px",
        "uiSm": "13px",
        "uiMd": "14px",
        "bodyMd": "16px",
        "bodyLg": "18px",
        "titleMobile": "clamp(2.35rem, 11vw, 4rem)",
        "titleDesktop": "clamp(3rem, 4vw, 4.5rem)",
        "sectionDesktop": "2rem",
        "sectionMobile": "1.65rem"
      },
      "fontWeight": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extrabold": 800
      },
      "lineHeight": {
        "tight": 1.15,
        "body": 1.72,
        "bodyDense": 1.6,
        "ui": 1.45
      },
      "letterSpacing": {
        "none": "0",
        "tight": "-0.015em",
        "label": "0.08em",
        "section": "0.12em",
        "formula": "0.16em"
      }
    },
    "spacing": {
      "4": "4px",
      "8": "8px",
      "12": "12px",
      "16": "16px",
      "20": "20px",
      "24": "24px",
      "32": "32px",
      "40": "40px",
      "48": "48px",
      "64": "64px"
    },
    "radius": {
      "sm": "6px",
      "md": "8px",
      "lg": "16px",
      "xl": "20px",
      "xxl": "24px",
      "pill": "999px"
    },
    "shadow": {
      "soft": "0 10px 24px rgba(15, 23, 42, 0.045)",
      "card": "0 16px 32px rgba(15, 23, 42, 0.05)",
      "rail": "0 10px 30px rgba(15, 23, 42, 0.05)",
      "formula": "0 10px 24px rgba(15, 23, 42, 0.075)"
    },
    "borderWidth": {
      "thin": "1px",
      "focus": "2px",
      "formulaAccent": "3px"
    },
    "breakpoint": {
      "phone": "760px",
      "narrow": "900px",
      "tablet": "1080px",
      "desktop": "1024px",
      "wideRail": "1280px"
    }
  },
  "semantic": {
    "canvas": {
      "background": "{primitives.color.pageBg}",
      "surface": "{primitives.color.paper}",
      "surfaceSubtle": "{primitives.color.surfaceSubtle}",
      "surfaceWarm": "{primitives.color.surfaceWarm}"
    },
    "text": {
      "primary": "{primitives.color.ink}",
      "secondary": "{primitives.color.inkMuted}",
      "tertiary": "{primitives.color.inkSoft}",
      "brand": "{primitives.color.brandBlue}",
      "inverse": "{primitives.color.activeBrandText}"
    },
    "border": {
      "soft": "{primitives.color.lineSoft}",
      "default": "{primitives.color.line}",
      "strong": "{primitives.color.lineStrong}",
      "brand": "{primitives.color.lineBrand}"
    },
    "state": {
      "hover": "{primitives.color.hoverBrand}",
      "selected": "{primitives.color.activeBrand}",
      "selectedText": "{primitives.color.activeBrandText}"
    }
  },
  "layout": {
    "header": {
      "height": "56px",
      "paddingInline": "16px",
      "logoWidthDesktop": "138px",
      "logoWidthNarrow": "216px",
      "logoCompactFallback": "24px",
      "actionHitArea": "36px",
      "actionIcon": "20px",
      "searchWidthDesktop": "420px",
      "searchHeight": "36px",
      "searchRadius": "8px"
    },
    "shell": {
      "sidebarWidthBase": "256px",
      "sidebarWidthDesktop": "320px",
      "outlineWidth": "256px",
      "contentMaxWidth": "896px",
      "pagePaddingDesktop": "32px 24px 48px",
      "pagePaddingTablet": "24px 20px 40px",
      "pagePaddingPhone": "16px"
    }
  },
  "components": {
    "sidebar": {
      "sectionLabelSize": "12px",
      "sectionLabelTracking": "0.12em",
      "itemPadding": "8px 12px",
      "itemRadius": "8px",
      "itemGap": "4px",
      "itemTitleSize": "14px",
      "itemTitleLineHeight": "20px",
      "activeBackground": "{primitives.color.brandBlue}",
      "activeText": "{primitives.color.activeBrandText}",
      "hoverBackground": "rgba(233, 239, 255, 1)"
    },
    "outlineRail": {
      "padding": "16px",
      "sectionGap": "8px",
      "labelSize": "12px",
      "itemSize": "14px",
      "itemLineHeight": "1.5",
      "activeDotSize": "8px"
    },
    "mobileChapterBar": {
      "minHeight": "48px",
      "padding": "0.85rem 1rem",
      "gap": "0.75rem",
      "titleSize": "14px",
      "metaSize": "13px",
      "gridTemplate": "auto auto minmax(0,1fr) auto"
    },
    "mobileOutlineCard": {
      "padding": "14px 16px",
      "radius": "14px",
      "labelSize": "12px",
      "itemSize": "14px",
      "itemGap": "0.75rem"
    },
    "article": {
      "eyebrowSize": "12px",
      "eyebrowTracking": "0.12em",
      "titleSizeDesktop": "{primitives.typography.fontSize.titleDesktop}",
      "titleSizeMobile": "{primitives.typography.fontSize.titleMobile}",
      "titleLineHeight": "1.08",
      "metaSize": "14px",
      "bodySize": "16px",
      "bodyLineHeight": "1.72",
      "bodyMaxMeasure": "68ch",
      "sectionTitleSizeDesktop": "2rem",
      "sectionTitleSizeMobile": "1.65rem",
      "sectionMarkerWidth": "32px",
      "sectionMarkerHeight": "3px"
    },
    "formula": {
      "shellPaddingDesktop": "13px 22px 12px",
      "shellPaddingMobile": "12px 14px 12px",
      "radius": "6px",
      "border": "1px solid rgba(49, 99, 194, 0.14)",
      "borderAccent": "3px solid rgba(49, 99, 194, 0.72)",
      "background": "linear-gradient(180deg, #ffffff 0%, rgba(248, 250, 252, 0.96) 100%)",
      "shadow": "{primitives.shadow.formula}",
      "labelSize": "0.92rem",
      "labelWeight": 800,
      "labelTracking": "0.16em",
      "expressionSize": "clamp(14.4px, 1vw, 16.8px)",
      "noteSize": "0.95rem"
    },
    "figure": {
      "cardPadding": "14px",
      "cardRadius": "20px",
      "cardBorder": "1px solid rgba(11, 31, 51, 0.10)",
      "cardShadow": "{primitives.shadow.card}",
      "mediaPadding": "0.9rem",
      "mediaRadius": "16px",
      "mediaGap": "1rem",
      "imageRadius": "6px",
      "labelSize": "12px",
      "labelTracking": "0.08em",
      "captionGap": "0.9rem",
      "captionSize": "14px",
      "captionLineHeight": "1.55",
      "insetMaxWidth": "calc(100% - 1.75rem)"
    },
    "table": {
      "shellRadius": "16px",
      "shellBorder": "1px solid rgba(148, 163, 184, 0.22)",
      "shellBackground": "linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(248, 250, 252, 0.95) 100%)",
      "shellShadow": "0 14px 28px rgba(15, 23, 42, 0.05)",
      "captionLabelSize": "11px",
      "captionTextSize": "16px",
      "captionTextStyle": "italic",
      "scrollPaddingDesktop": "0.75rem",
      "scrollPaddingMobile": "0.65rem",
      "headerBackground": "{primitives.color.brandBlueDeep}",
      "headerText": "#FFFFFF",
      "cellTextSize": "14px",
      "noteTextSize": "12px"
    },
    "pagination": {
      "gap": "0.8rem",
      "cardMinHeight": "52px",
      "cardPadding": "9px 18px",
      "cardRadius": "15px",
      "cardShadow": "0 8px 22px rgba(15, 23, 42, 0.04)",
      "labelSize": "0.74rem",
      "titleSize": "1.24rem",
      "iconCircle": "36px"
    }
  },
  "implementationHints": {
    "wideScreenPrinciple": [
      "Retain the three-column academic shell: left chapter navigation, center reading column, right page outline.",
      "Keep figures, formulas, and tables as framed scholarly artifacts rather than flat inline blocks.",
      "Preserve the landing-page brand palette, but let academic reading rhythm dominate over marketing emphasis."
    ],
    "narrowScreenPrinciple": [
      "Collapse global navigation, chapter context, and on-page outline into stacked lightweight bars and cards.",
      "Keep the full horizontal landing-page logo lockup; do not replace it with the compact mark in the approved mobile reference.",
      "Reuse the same figure, formula, and table visual language from wide screen, only changing spacing and stacking behavior."
    ]
  },
  "cssCustomProperties": {
    "--reader-ink": "{primitives.color.ink}",
    "--reader-muted": "{primitives.color.inkMuted}",
    "--reader-bg": "{primitives.color.pageBg}",
    "--reader-surface": "{primitives.color.paper}",
    "--reader-surface-subtle": "{primitives.color.surfaceSubtle}",
    "--reader-brand": "{primitives.color.brandBlue}",
    "--reader-brand-deep": "{primitives.color.brandBlueDeep}",
    "--reader-brand-gold": "{primitives.color.brandGold}",
    "--reader-accent": "{primitives.color.accentCopper}",
    "--reader-line": "{primitives.color.line}",
    "--reader-line-strong": "{primitives.color.lineStrong}",
    "--reader-header-height": "{layout.header.height}",
    "--reader-sidebar-width": "{layout.shell.sidebarWidthDesktop}",
    "--reader-sidebar-width-base": "{layout.shell.sidebarWidthBase}",
    "--reader-outline-width": "{layout.shell.outlineWidth}",
    "--reader-content-max": "{layout.shell.contentMaxWidth}",
    "--reader-logo-width-desktop": "{layout.header.logoWidthDesktop}",
    "--reader-logo-width-narrow": "{layout.header.logoWidthNarrow}",
    "--reader-figure-radius": "{components.figure.cardRadius}",
    "--reader-table-radius": "{components.table.shellRadius}",
    "--reader-formula-radius": "{components.formula.radius}"
  }
}
